# ---- HTTP ----
PORT=3042
NODE_ENV=development
LOG_LEVEL=info

# ---- Authorization ----
# Callers send their token in the Authorization header; it is verified against this service.
AUTH_URL=https://devops-apis.nam.nsroot.net/activeDirectory/authorize
AUTH_TIMEOUT_MS=5000
# Used when a request does not name a sender.
NOTIFICATION_SENDER=noreply@example.com

# ---- SMTP ----
SMTP_HOST=smtp.example.com
SMTP_PORT=25
# true = implicit TLS (port 465). Otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=30000

# ---- Delivery limits ----
# Recipients (to + cc + bcc) per SMTP message. 1-300.
MAIL_BATCH_SIZE=100
# Gateway limit for one message after base64 encoding, in bytes (24 MiB, max 25 MiB).
MAIL_MAX_MESSAGE_BYTES=25165824
# Total size of attachment files before encoding, in bytes (15 MiB).
MAIL_MAX_ATTACHMENT_BYTES=15728640
MAIL_MAX_ATTACHMENTS=10
# A message of at least this size (5 MiB) goes to at most this many recipients at a time.
MAIL_LARGE_MESSAGE_BYTES=5242880
MAIL_LARGE_MESSAGE_MAX_RECIPIENTS=20
# Attachments arrive as base64 inside the JSON request, so keep this above MAIL_MAX_MESSAGE_BYTES.
MAIL_BODY_LIMIT=30mb
