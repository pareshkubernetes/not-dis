# ---- HTTP ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Callers (optional) ----
# When both are set, every request must carry matching Basic credentials.
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
# Used when a request does not name a sender.
NOTIFICATION_SENDER=noreply@example.com

# ---- SMTP ----
SMTP_HOST=smtp.example.com
SMTP_PORT=25
# true = implicit TLS (port 465). Otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=30000

# ---- Delivery limits ----
# Recipients (to + cc + bcc) per SMTP message. 1-300.
MAIL_BATCH_SIZE=100
# Largest message after base64 encoding, in bytes (default 20 MiB, max 25 MiB).
MAIL_MAX_MESSAGE_BYTES=20971520
MAIL_MAX_ATTACHMENTS=10
# Attachments are file names relative to this directory; nothing outside it can be attached.
MAIL_ATTACHMENT_DIR=./attachments
MAIL_BODY_LIMIT=1mb
